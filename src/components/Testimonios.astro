---
// Videos en public/videos/ — verticales (9:16), comprimidos para web, con póster .webp del mismo nombre
const base = import.meta.env.BASE_URL;
const videos = [
  { archivo: 'sponsor-3dental-1', tipo: 'Sponsor', quien: '3Dental Digital', frase: 'Este es un punto de partida: queremos seguir participando.' },
  { archivo: 'sponsor-3dental-2', tipo: 'Sponsor', quien: '3Dental Digital', frase: 'Una tremenda experiencia. Se nota mucha práctica y vocación.' },
  { archivo: 'alumno-1', tipo: 'Alumno', quien: 'Curso Rehabilitación Digital', frase: 'Mostraron de principio a fin la realidad del día a día en la clínica.' },
  { archivo: 'alumno-2', tipo: 'Alumno', quien: 'Curso Rehabilitación Digital', frase: 'Me sorprendió el nivel de los expositores.' },
];
---

<!-- TESTIMONIOS PRIMER CURSO -->
<section id="testimonios" class="py-20 px-6 bg-white">
  <div class="max-w-7xl mx-auto">
    <div class="max-w-2xl mx-auto text-center mb-12">
      <span class="inline-block bg-secondary text-white text-xs font-semibold px-3 py-1 rounded-full mb-4">Primer curso · Noviembre 2026</span>
      <h2 class="text-3xl font-extrabold text-dark mb-4">Así se vivió nuestro primer curso</h2>
      <p class="text-gray-500 leading-relaxed">Las impresiones de sponsors y alumnos que fueron parte de Rehabilitación Digital.</p>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 max-w-5xl mx-auto">
      {videos.map((v) => (
        <figure class="group">
          <div class="js-testimonio relative aspect-[9/16] rounded-2xl overflow-hidden bg-dark shadow-sm border border-light">
            <video
              class="absolute inset-0 w-full h-full object-cover"
              src={`${base}videos/${v.archivo}.mp4`}
              poster={`${base}videos/${v.archivo}.webp`}
              preload="none"
              playsinline
              aria-label={`Testimonio ${v.tipo.toLowerCase()} — ${v.quien}`}
            ></video>
            <button type="button" class="js-play absolute inset-0 flex items-center justify-center bg-gradient-to-t from-black/60 via-black/10 to-transparent transition-opacity" aria-label={`Reproducir testimonio de ${v.tipo.toLowerCase()}`}>
              <span class="w-14 h-14 rounded-full bg-white/95 text-primary flex items-center justify-center shadow-lg transition-transform group-hover:scale-110">
                <svg class="w-6 h-6 ml-0.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l11.2-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14Z"/></svg>
              </span>
              <span class="absolute left-3 top-3 bg-primary text-white text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full">{v.tipo}</span>
            </button>
          </div>
          <figcaption class="mt-3">
            <p class="text-sm font-semibold text-dark leading-snug">“{v.frase}”</p>
            <p class="text-xs text-gray-500 mt-1">{v.tipo} · {v.quien}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const items = document.querySelectorAll('.js-testimonio');
    items.forEach(function (item) {
      const video = item.querySelector('video');
      const btn = item.querySelector('.js-play');
      if (!video || !btn) return;
      btn.addEventListener('click', function () {
        // Pausa los demás antes de reproducir este
        items.forEach(function (o) { const ov = o.querySelector('video'); if (ov && ov !== video) ov.pause(); });
        video.controls = true;
        btn.classList.add('hidden');
        video.play();
      });
      video.addEventListener('ended', function () {
        video.controls = false;
        video.load(); // vuelve al póster
        btn.classList.remove('hidden');
      });
    });
  })();
</script>
