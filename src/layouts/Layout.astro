---
import TopHeader from '../components/TopHeader.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
}

const {
  title = 'Academia Dental — Cursos de Odontología en Temuco',
  description = 'Cursos de odontología presenciales y híbridos dictados por especialistas en Temuco, Araucanía. Formación continua de alto nivel para odontólogos de la Novena Región y todo Chile.',
  keywords = 'cursos de odontología Temuco, cursos dentales Araucanía, formación odontológica Novena Región, educación continua odontología Chile, Academia Dental Temuco',
  image,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="geo.region" content="CL-AR" />
    <meta name="geo.placename" content="Temuco, Araucanía, Chile" />
    <meta name="author" content="Academia Dental" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Academia Dental" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <style>
      .text-sm { font-size: 0.975rem; }
    </style>
  </head>
  <body class="font-sans text-dark bg-white antialiased">
    <TopHeader />
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
  </body>
</html>
