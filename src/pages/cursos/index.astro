---
import Layout from '../../layouts/Layout.astro';
import CourseCard from '../../components/CourseCard.astro';
import PageHero from '../../components/PageHero.astro';
import { getCursos, getCategoriasCurso, getFeaturedImage } from '../../lib/wp';

const categorias = await getCategoriasCurso();
const cursos = await getCursos();

const categoriaActiva = Astro.url.searchParams.get('categoria') ?? 'todos';

const cursosFiltrados = categoriaActiva === 'todos'
  ? cursos
  : cursos.filter((c: any) => {
      const slugs = c.curso_categoria_slugs ?? [];
      return slugs.includes(categoriaActiva);
    });

function anioDe(c: any): number | null {
  const raw = String(c.acf?.fecha ?? '').trim();
  if (/^\d{8}$/.test(raw)) { const y = +raw.slice(0, 4); return y > 2000 ? y : null; }
  if (/^\d{4}-\d{2}-\d{2}/.test(raw)) { const y = +raw.slice(0, 4); return y > 2000 ? y : null; }
  if (/^\d{4}$/.test(raw)) { const y = +raw; return y > 2000 ? y : null; }
  return null;
}
const grupos: Record<string, any[]> = {};
for (const c of cursosFiltrados) {
  const y = anioDe(c);
  const key = y ? String(y) : 'proximamente';
  (grupos[key] ??= []).push(c);
}
const anios = Object.keys(grupos).sort((a, b) =>
  (a === 'proximamente' ? 9999 : +a) - (b === 'proximamente' ? 9999 : +b)
);
---

<Layout title="Cursos de Odontología en Temuco | Academia Dental" description="Cursos de odontología en Temuco, Araucanía (Novena Región), Chile: ortodoncia, rehabilitación oral, implantología, endodoncia y odontología digital. Formación continua para odontólogos, dictada por especialistas." keywords="cursos de odontología Temuco, cursos dentales Araucanía, cursos de ortodoncia Temuco, cursos de rehabilitación oral Temuco, implantología Temuco, odontología digital Araucanía, educación continua odontología Chile, Academia Dental Temuco">

  <PageHero
    title="Cursos 2026-2027"
    breadcrumb={[{ label: 'Cursos' }]}
    image={`${import.meta.env.BASE_URL}images/cursos.webp`}
    imagePosition="center 90%"
  />

  <!-- Grid cursos -->
  <section class="py-16 px-6 bg-[#F5F7FA]">
    <div class="max-w-7xl mx-auto">
      {cursosFiltrados.length > 0 ? (
        <div class="space-y-14">
          {anios.map((anio) => (
            <div>
              <div class="flex items-center gap-4 mb-6">
                <h2 class="text-2xl font-extrabold text-dark whitespace-nowrap">{anio === 'proximamente' ? 'Próximos cursos' : `Cursos ${anio}`}</h2>
                <span class="h-px flex-1 bg-light"></span>
                <span class="text-sm text-gray-400 font-medium">{grupos[anio].length} {grupos[anio].length === 1 ? 'curso' : 'cursos'}</span>
              </div>
              <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                {grupos[anio].map((curso: any) => (
                  <CourseCard
                    title={curso.title?.rendered ?? curso.title}
                    slug={curso.slug}
                    image={getFeaturedImage(curso)}
                    categoria={curso.acf?.modalidad ?? ''}
                    modalidad={curso.acf?.modalidad ?? ''}
                    fecha={curso.acf?.fecha ?? ''}
                    precio={curso.acf?.precio ?? ''}
                  />
                ))}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="text-center py-20 text-gray-400">
          <svg class="w-16 h-16 mx-auto mb-4 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <p class="text-lg font-medium">No se encontraron cursos en esta categoría.</p>
          <a href={`${import.meta.env.BASE_URL}cursos`} class="mt-4 inline-block text-primary font-semibold hover:underline">Ver todos los cursos</a>
        </div>
      )}
    </div>
  </section>

</Layout>
