---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

// Logos en public/images/sponsors/ — canvas horizontal 400x160 PNG transparente
const sponsors = [
  { nombre: 'Odontotek', rubro: 'Implantes dentales', web: '', logo: 'images/sponsors/odontotek.png' },
  { nombre: 'Odonto Import', rubro: 'Insumos y equipamiento dental', web: '', logo: 'images/sponsors/odonto-import.png' },
];
---

<Layout title="Sponsors — Academia Dental" description="Empresas que auspician y acompañan la formación de Academia Dental en Temuco.">

  <PageHero
    title="Sponsors"
    breadcrumb={[{ label: 'Sponsors' }]}
    image={`${import.meta.env.BASE_URL}images/bg-contacto.webp`}
    imagePosition="center 35%"
  />

  <!-- LISTADO -->
  <section class="py-20 px-6 bg-white">
    <div class="max-w-5xl mx-auto text-center mb-14">
      <h2 class="text-3xl font-extrabold text-dark mb-4">Empresas que nos acompañan</h2>
      <p class="text-gray-500 leading-relaxed max-w-2xl mx-auto">
        Nuestros cursos son posibles gracias a las marcas que apoyan la formación clínica continua en la región.
      </p>
    </div>

    <div class="max-w-3xl mx-auto grid grid-cols-1 sm:grid-cols-2 gap-6">
      {sponsors.map(s => (
        <a
          href={s.web || '#'}
          target={s.web ? '_blank' : undefined}
          rel={s.web ? 'noopener' : undefined}
          class="group bg-white border border-light rounded-2xl p-6 flex flex-col items-center justify-center text-center shadow-sm hover:shadow-md transition-shadow"
        >
          <div class="h-28 w-full flex items-center justify-center mb-4">
            {s.logo ? (
              <img src={`${import.meta.env.BASE_URL}${s.logo}`} alt={s.nombre} loading="lazy" class="max-h-24 w-auto object-contain transition-transform duration-300 group-hover:scale-105" />
            ) : (
              <span class="text-lg font-extrabold text-dark/30 tracking-wide">{s.nombre}</span>
            )}
          </div>
          <h3 class="font-bold text-dark text-sm">{s.nombre}</h3>
          <p class="text-xs text-gray-500 mt-1">{s.rubro}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- CTA AUSPICIAR -->
  <section class="py-20 px-6 text-white" style="background-color:#0E3A6B">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl font-extrabold mb-4">¿Quieres auspiciar nuestros cursos?</h2>
      <p class="text-blue-100 leading-relaxed mb-8 max-w-2xl mx-auto">
        Si tu empresa quiere llegar a odontólogos en formación continua de La Araucanía, conversemos.
        Te enviamos el plan de auspicios con alcance, formatos y valores.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="mailto:drmilenium@gmail.com" class="inline-flex items-center justify-center gap-2 bg-white text-primary font-semibold px-6 py-3 rounded-xl hover:bg-blue-50 transition-colors">
          drmilenium@gmail.com
        </a>
        <a href="https://wa.me/56998447356?text=Hola%2C%20quiero%20informaci%C3%B3n%20sobre%20auspicios%20en%20Academia%20Dental" target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 bg-green-500 hover:bg-green-400 text-white font-semibold px-6 py-3 rounded-xl transition-colors">
          WhatsApp +56 9 9844 7356
        </a>
      </div>
    </div>
  </section>

</Layout>
