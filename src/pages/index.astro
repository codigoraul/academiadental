---
import Layout from '../layouts/Layout.astro';
import CourseCard from '../components/CourseCard.astro';
import { getCursoBySlug, getFeaturedImage } from '../lib/wp';
import PreInscripcion from '../components/PreInscripcion.astro';

const cursoDestacado = await getCursoBySlug('rehabilitacion-digital');
const cursos = cursoDestacado ? [cursoDestacado] : [];
---

<Layout title="Academia Dental Temuco | Cursos de Odontología en la Araucanía" description="Academia Dental en Temuco: cursos de odontología presenciales y prácticos en la Araucanía (Novena Región), Chile. Ortodoncia, rehabilitación, implantología y odontología digital dictados por especialistas." keywords="Academia Dental Temuco, cursos de odontología Temuco, cursos dentales Araucanía, formación odontológica Novena Región, educación continua odontología Chile, cursos de ortodoncia y rehabilitación Temuco">

  <!-- HERO SLIDER -->
  <section id="hero" class="relative text-white pt-24 pb-20 lg:pt-32 lg:pb-24 px-6 overflow-hidden lg:min-h-[620px] flex flex-col justify-center" style={`background-image: url('${import.meta.env.BASE_URL}images/hero-bg-temuco.webp'); background-size: cover; background-position: center;`}>
    <div class="absolute inset-0" style="background: linear-gradient(100deg, rgba(6, 20, 50, 0.94) 0%, rgba(8, 28, 70, 0.80) 45%, rgba(10, 30, 74, 0.70) 100%);"></div>
    <div class="absolute -right-40 top-1/2 -translate-y-1/2 w-[720px] h-[720px] rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(19, 159, 239, 0.28) 0%, rgba(19, 159, 239, 0) 65%);" aria-hidden="true"></div>
    <div class="absolute inset-x-0 bottom-0 h-24 pointer-events-none" style="background: linear-gradient(to bottom, rgba(6,20,50,0) 0%, rgba(6,20,50,0.55) 100%);" aria-hidden="true"></div>
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-secondary/60 to-transparent" aria-hidden="true"></div>

    <div id="hero-slider" class="relative z-10 max-w-7xl mx-auto w-full grid" data-active="0">

      <!-- SLIDE 1 -->
      <div class="hero-slide col-start-1 row-start-1 grid lg:grid-cols-[1.1fr_0.9fr] gap-10 lg:gap-16 items-center transition-opacity duration-700" data-slide="0">
        <div>
          <span class="inline-flex items-center gap-2 bg-white/10 border border-white/20 backdrop-blur-sm text-white text-xs sm:text-sm font-semibold tracking-wide uppercase px-4 py-1.5 rounded-full mb-6">
            <span class="w-1.5 h-1.5 rounded-full bg-secondary" aria-hidden="true"></span>
            Clínica Milenium — Formación Continua
          </span>
          <h1 class="text-4xl sm:text-5xl lg:text-[3.5rem] font-extrabold leading-[1.1] tracking-tight mb-6">
            Formación Clínica de <span class="bg-gradient-to-r from-[#7CCBFF] to-secondary bg-clip-text text-transparent">Alto Nivel</span> para Odontólogos
          </h1>
          <p class="text-lg sm:text-xl text-blue-100/90 mb-9 leading-relaxed max-w-xl">
            Cursos presenciales y híbridos dictados por especialistas. Aprende, practica y certifícate.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href={`${import.meta.env.BASE_URL}cursos`} class="group inline-flex items-center gap-2 bg-white text-primary font-bold px-7 py-3.5 rounded-full shadow-lg shadow-black/25 hover:bg-blue-50 hover:shadow-xl transition-all">
              Ver Cursos
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12l-7.5 7.5M21 12H3"/></svg>
            </a>
            <a href={`${import.meta.env.BASE_URL}contacto`} class="inline-flex items-center gap-2 border border-white/50 bg-white/5 backdrop-blur-sm text-white font-bold px-7 py-3.5 rounded-full hover:bg-white/15 hover:border-white transition-all">
              Contáctanos
            </a>
          </div>
        </div>
        <div>
          <a href={`${import.meta.env.BASE_URL}cursos/rehabilitacion-digital`} class="group relative block overflow-hidden bg-[#0b1f45]/90 backdrop-blur-md border border-white/15 rounded-3xl p-7 lg:p-9 shadow-2xl shadow-black/40 transition-all duration-300 hover:-translate-y-1 hover:border-secondary/70 hover:shadow-secondary/20">
            <span class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-primary via-secondary to-[#7CCBFF]" aria-hidden="true"></span>
            <span class="inline-flex items-center gap-2 bg-secondary text-white text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-full mb-5">
              <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span> Curso 2026 · Inscripciones abiertas
            </span>
            <p class="font-extrabold text-3xl lg:text-[2.1rem] leading-tight tracking-tight mb-3 text-white">Rehabilitación Digital</p>
            <p class="text-blue-100 mb-5">De la planificación a la restauración definitiva.</p>
            <div class="text-sm text-blue-100 space-y-2.5 border-t border-white/10 pt-5">
              <p class="flex items-center gap-2"><svg class="w-4 h-4 text-secondary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"/></svg>Sáb 14 y Dom 15 de noviembre 2026</p>
              <p class="flex items-center gap-2"><svg class="w-4 h-4 text-secondary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/></svg>Academia Dental, Temuco</p>
            </div>
            <span class="inline-flex items-center gap-2 mt-6 bg-secondary/15 border border-secondary/40 text-white font-bold text-sm px-5 py-2.5 rounded-full group-hover:bg-secondary group-hover:gap-3 transition-all">Ver curso <span aria-hidden="true">→</span></span>
          </a>
        </div>
      </div>

      <!-- SLIDE 2 · PRE INSCRIPCIÓN 2027 -->
      <div class="hero-slide col-start-1 row-start-1 grid lg:grid-cols-[1.1fr_0.9fr] gap-10 lg:gap-16 items-center transition-opacity duration-700 opacity-0 pointer-events-none" data-slide="1" aria-hidden="true">
        <div>
          <span class="inline-flex items-center gap-2 bg-secondary text-white text-sm font-semibold px-4 py-1.5 rounded-full mb-6">
            <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span> Pre inscripción abierta
          </span>
          <h2 class="text-4xl sm:text-5xl lg:text-[3.5rem] font-extrabold leading-[1.1] tracking-tight mb-6">
            Ya puedes pre inscribirte a nuestros <span class="bg-gradient-to-r from-[#7CCBFF] to-secondary bg-clip-text text-transparent">Cursos 2027</span>
          </h2>
          <p class="text-lg sm:text-xl text-blue-100/90 mb-9 leading-relaxed max-w-xl">
            Déjanos tus datos y sé parte de la próxima generación de profesionales que siguen creciendo con nosotros.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="https://wa.me/56998447356?text=Hola%2C%20quiero%20pre%20inscribirme%20a%20los%20cursos%202027%20de%20Academia%20Dental" target="_blank" rel="noopener" class="group inline-flex items-center gap-2 bg-white text-primary font-bold px-7 py-3.5 rounded-full shadow-lg shadow-black/25 hover:bg-blue-50 hover:shadow-xl transition-all">
              Pre inscríbete aquí
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12l-7.5 7.5M21 12H3"/></svg>
            </a>
            <a href="#preinscripcion" class="inline-flex items-center gap-2 border border-white/50 bg-white/5 backdrop-blur-sm text-white font-bold px-7 py-3.5 rounded-full hover:bg-white/15 hover:border-white transition-all">
              Ver más
            </a>
          </div>
        </div>
        <div class="hidden lg:grid grid-cols-2 gap-4">
          {[
            { t: 'Recibe primero', d: 'las fechas oficiales', icon: 'M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0' },
            { t: 'Información', d: 'exclusiva', icon: 'M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75' },
            { t: 'Acceso prioritario', d: 'a cupos', icon: 'M11.48 3.5a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z' },
            { t: 'Sé parte', d: 'de nuestra comunidad', icon: 'M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5' },
          ].map(item => (
            <div class="bg-white/[0.07] border border-white/15 rounded-2xl p-6 backdrop-blur-sm hover:bg-white/[0.12] hover:border-secondary/50 transition-colors">
              <svg class="w-9 h-9 mb-4 p-2 rounded-xl bg-secondary/20 text-[#7CCBFF]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
              </svg>
              <p class="font-bold text-base mb-0.5">{item.t}</p>
              <p class="text-sm text-blue-100">{item.d}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Controles -->
    <div class="relative z-10 max-w-7xl mx-auto w-full mt-12 flex items-center gap-3">
      <button type="button" id="hero-prev" aria-label="Anterior" class="w-11 h-11 rounded-full border border-white/30 bg-white/5 backdrop-blur-sm hover:bg-white/15 hover:border-white/60 flex items-center justify-center transition-colors">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
      </button>
      <button type="button" id="hero-next" aria-label="Siguiente" class="w-11 h-11 rounded-full border border-white/30 bg-white/5 backdrop-blur-sm hover:bg-white/15 hover:border-white/60 flex items-center justify-center transition-colors">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </button>
      <div class="flex gap-2 ml-2">
        <button type="button" class="hero-dot w-10 h-1.5 rounded-full bg-white transition-all duration-300" data-goto="0" aria-label="Ir al slide 1"></button>
        <button type="button" class="hero-dot w-5 h-1.5 rounded-full bg-white/35 transition-all duration-300" data-goto="1" aria-label="Ir al slide 2"></button>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const slider = document.getElementById('hero-slider');
      if (!slider) return;
      const slides = [...slider.querySelectorAll('.hero-slide')];
      const dots = [...document.querySelectorAll('.hero-dot')];
      let i = 0;
      let timer = null;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const go = (n) => {
        i = (n + slides.length) % slides.length;
        slides.forEach((s, k) => {
          const on = k === i;
          s.classList.toggle('opacity-0', !on);
          s.classList.toggle('pointer-events-none', !on);
          s.setAttribute('aria-hidden', String(!on));
        });
        dots.forEach((d, k) => {
          d.classList.toggle('bg-white', k === i);
          d.classList.toggle('bg-white/35', k !== i);
          d.classList.toggle('w-10', k === i);
          d.classList.toggle('w-5', k !== i);
        });
      };

      const start = () => { if (!reduce) timer = setInterval(() => go(i + 1), 7000); };
      const stop = () => { if (timer) clearInterval(timer); timer = null; };

      document.getElementById('hero-prev')?.addEventListener('click', () => { stop(); go(i - 1); start(); });
      document.getElementById('hero-next')?.addEventListener('click', () => { stop(); go(i + 1); start(); });
      dots.forEach(d => d.addEventListener('click', () => { stop(); go(Number(d.dataset.goto)); start(); }));

      const hero = document.getElementById('hero');
      hero?.addEventListener('mouseenter', stop);
      hero?.addEventListener('mouseleave', start);
      document.addEventListener('visibilitychange', () => document.hidden ? stop() : start());

      go(0);
      start();
    })();
  </script>

  <!-- VENTAJAS -->
  <section class="py-20 px-6 bg-white">
    <div class="max-w-7xl mx-auto text-center mb-12">
      <h2 class="text-3xl font-extrabold text-dark mb-4">¿Por qué Academia Dental?</h2>
      <p class="text-gray-500 max-w-2xl mx-auto">Tres pilares que hacen la diferencia en tu formación continua.</p>
    </div>
    <div class="max-w-7xl mx-auto grid md:grid-cols-3 gap-8">
      {[
        {
          icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>`,
          title: 'Docentes Especialistas',
          desc: 'Profesionales activos con experiencia clínica real, referentes en su área de especialidad.',
        },
        {
          icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>`,
          title: 'Práctica Hands-On',
          desc: 'Metodología enfocada en el hacer, no solo el escuchar. Casos clínicos reales desde el primer módulo.',
        },
        {
          icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>`,
          title: 'Práctica Real',
          desc: 'Práctica real en pacientes, para que apliques lo aprendido en situaciones clínicas concretas.',
        },
      ].map(item => (
        <div class="text-center p-8 rounded-2xl border border-light hover:shadow-md transition-shadow">
          <div class="w-14 h-14 bg-blue-50 rounded-2xl flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={item.icon} />
          </div>
          <h3 class="font-bold text-dark text-lg mb-3">{item.title}</h3>
          <p class="text-gray-500 text-sm leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CURSOS DESTACADOS -->
  <section class="py-20 px-6 bg-[#F5F7FA]">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-end justify-between mb-10">
        <div>
          <h2 class="text-3xl font-extrabold text-dark mb-2">Cursos 2026</h2>
          <p class="text-gray-500">Nuestro próximo curso disponible.</p>
        </div>
        <a href={`${import.meta.env.BASE_URL}cursos`} class="hidden md:inline-flex items-center gap-2 text-primary font-semibold text-sm hover:text-secondary transition-colors">
          Ver todos <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
      {cursos.length > 0 ? (
        <div class="grid gap-6 max-w-md mx-auto">
          {cursos.map((curso: any) => (
            <CourseCard
              title={curso.title?.rendered ?? curso.title}
              slug={curso.slug}
              image={getFeaturedImage(curso)}
              categoria={curso.acf?.modalidad ?? ''}
              modalidad={curso.acf?.modalidad ?? ''}
              fecha={curso.acf?.fecha ?? ''}
              precio={curso.acf?.precio ?? ''}
            />
          ))}
        </div>
      ) : (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {['Ortodoncia Avanzada Clínica', 'Rehabilitación Estética Full Mouth', 'Odontología Digital & CAD/CAM'].map((nombre) => (
            <div class="bg-white rounded-2xl border border-light p-6 shadow-sm">
              <div class="h-40 bg-light rounded-xl mb-4 flex items-center justify-center">
                <svg class="w-12 h-12 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
              </div>
              <span class="inline-block bg-secondary text-white text-xs font-semibold px-3 py-1 rounded-full mb-3">Curso</span>
              <h3 class="font-bold text-dark mb-4">{nombre}</h3>
              <a href={`${import.meta.env.BASE_URL}cursos`} class="block text-center bg-primary hover:bg-secondary text-white text-sm font-semibold py-2.5 rounded-xl transition-colors">Ver más</a>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <PreInscripcion />

  <!-- METODOLOGÍA RESUMIDA -->
  <section class="py-20 px-6 text-white" style="background-color:#0E3A6B">
    <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="text-3xl font-extrabold mb-4">Nuestra Metodología</h2>
        <p class="text-blue-100 leading-relaxed mb-6">
          Cada programa está diseñado para llevar el conocimiento teórico directamente a la práctica clínica. Trabajamos con pequeños grupos para garantizar una experiencia personalizada de alto impacto.
        </p>
        <a href={`${import.meta.env.BASE_URL}metodologia`} class="inline-flex items-center gap-2 text-white font-semibold border-b border-white/50 hover:border-white pb-0.5 transition-colors">
          Conoce más <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
      <div class="grid grid-cols-2 gap-4">
        {[
          { title: 'Presencial Hands-On', desc: 'Práctica directa en clínica desde el primer módulo.' },
          { title: 'Modelo Híbrido', desc: 'Teoría online + práctica presencial en sede.' },
          { title: 'Práctica Clínica', desc: 'Atención de pacientes reales bajo supervisión.' },
          { title: 'Material Entregado', desc: 'Kit completo de instrumental y material de estudio.' },
        ].map(item => (
          <div class="bg-white/10 border border-white/20 rounded-2xl p-5">
            <h4 class="font-bold text-sm mb-1">{item.title}</h4>
            <p class="text-xs text-blue-200 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="py-20 px-6 bg-light">
    <div class="max-w-4xl mx-auto text-center mb-12">
      <h2 class="text-3xl font-extrabold text-dark mb-4">¿Listo para dar el siguiente paso en tu carrera?</h2>
      <p class="text-gray-500">Completa el formulario y te contactamos con toda la información del curso que te interesa.</p>
    </div>
    <div class="max-w-2xl mx-auto bg-white rounded-2xl shadow-sm border border-light p-8">
      <form class="space-y-4" action="#" method="POST">
        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-dark mb-1">Nombre</label>
            <input type="text" name="nombre" placeholder="Tu nombre completo" required
              class="w-full border border-light rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition" />
          </div>
          <div>
            <label class="block text-sm font-medium text-dark mb-1">Email</label>
            <input type="email" name="email" placeholder="tu@email.com" required
              class="w-full border border-light rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition" />
          </div>
        </div>
        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-dark mb-1">Teléfono</label>
            <input type="tel" name="telefono" placeholder="+56 9 ..."
              class="w-full border border-light rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition" />
          </div>
