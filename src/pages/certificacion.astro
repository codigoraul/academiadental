---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout title="Certificación — Academia Dental" description="Conoce los requisitos, tipos de certificados y el proceso de certificación de Academia Dental Clínica Milenium.">

  <PageHero
    title="Certificación"
    breadcrumb={[{ label: 'Certificación' }]}
    image="/images/bg-certificacion.webp"
  />

  <section class="py-20 px-6 bg-white">
    <div class="max-w-3xl mx-auto space-y-16">

      <!-- Requisitos -->
      <div>
        <div class="flex items-center gap-4 mb-6">
          <div class="w-12 h-12 bg-blue-50 rounded-2xl flex items-center justify-center shrink-0">
            <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
            </svg>
          </div>
          <h2 class="text-2xl font-extrabold text-dark">Requisitos para obtener el certificado</h2>
        </div>
        <div class="bg-[#F5F7FA] rounded-2xl p-8 space-y-4">
          {[
            { num: '01', text: 'Asistencia mínima del 80% a las sesiones del programa (presenciales y/o sincrónicas).' },
            { num: '02', text: 'Participación activa en las jornadas de práctica clínica contempladas en el programa.' },
            { num: '03', text: 'Aprobación de la evaluación práctica final supervisada por el docente.' },
            { num: '04', text: 'Entrega de los casos clínicos asignados dentro del plazo establecido.' },
            { num: '05', text: 'Cancelación total del programa al momento de rendir la evaluación final.' },
          ].map(req => (
            <div class="flex gap-4 items-start">
              <span class="text-primary font-extrabold text-lg w-8 shrink-0">{req.num}</span>
              <p class="text-gray-600 text-sm leading-relaxed pt-0.5">{req.text}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Tipo de certificado -->
      <div>
        <div class="flex items-center gap-4 mb-6">
          <div class="w-12 h-12 bg-blue-50 rounded-2xl flex items-center justify-center shrink-0">
            <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
            </svg>
          </div>
          <h2 class="text-2xl font-extrabold text-dark">Tipo de certificado</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          {[
            {
              title: 'Certificado de Asistencia y Aprobación',
              desc: 'Emitido por Academia Dental — Clínica Milenium. Acredita la participación y aprobación del programa, indicando horas lectivas, modalidad y área de especialización.',
              icon: 'scroll',
            },
            {
              title: 'Certificado de Participación',
              desc: 'Para participantes que completan las horas de asistencia mínima sin rendir la evaluación práctica final. Válido como respaldo de formación continua.',
              icon: 'clipboard',
            },
          ].map(cert => (
            <div class="bg-white border border-light rounded-2xl p-6 shadow-sm">
              <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-4">{cert.icon === 'scroll' ? <Fragment set:html={`<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/></svg>`} /> : <Fragment set:html={`<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25Z"/></svg>`} />}</div>
              <h3 class="font-bold text-dark text-lg mb-2">{cert.title}</h3>
              <p class="text-gray-500 text-sm leading-relaxed">{cert.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Ejemplo visual -->
      <div>
        <div class="flex items-center gap-4 mb-6">
          <div class="w-12 h-12 bg-blue-50 rounded-2xl flex items-center justify-center shrink-0">
            <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
          <h2 class="text-2xl font-extrabold text-dark">Ejemplo visual del certificado</h2>
        </div>
        <!-- Mockup certificado -->
        <div class="relative bg-gradient-to-br from-[#f7f9fc] via-white to-[#eef3fa] rounded-2xl p-3 sm:p-5 shadow-2xl shadow-primary/10 my-12 lg:my-16">
          <div class="relative border border-primary/30 rounded-xl overflow-hidden bg-white flex flex-col lg:aspect-[3/2]">
            <!-- Marco interior doble -->
            <div class="absolute inset-3 border border-primary/15 rounded-lg pointer-events-none"></div>
            <!-- Barra superior -->
            <div class="h-2 bg-gradient-to-r from-primary via-secondary to-primary"></div>

            <div class="px-6 sm:px-12 pt-12 pb-12 lg:pt-16 lg:pb-16 text-center relative flex-1 flex flex-col justify-center lg:scale-[0.9] origin-center">
              <!-- Marca de agua -->
              <img src="/favicon.svg" alt="" aria-hidden="true" class="absolute inset-0 m-auto w-56 opacity-[0.04] pointer-events-none select-none" />

              <!-- Logos -->
              <div class="flex items-center justify-center gap-6 mb-4">
                <img src="/academia-dental-ad.svg" alt="Academia Dental" class="h-8 sm:h-9 w-auto" />
                <span class="h-10 w-px bg-light"></span>
                <img src="/images/logo-milenium.jpg" alt="Clínica Milenium" class="h-7 sm:h-8 w-auto rounded" />
              </div>

              <p class="text-[11px] tracking-[0.35em] uppercase text-gray-400 font-semibold mb-1.5">Formación continua en odontología</p>
              <h3 class="text-2xl sm:text-[26px] font-extrabold text-primary tracking-tight mb-0.5">Certificado de Aprobación</h3>
              <p class="text-gray-500 text-sm mb-3">Otorgado a</p>

              <p class="font-serif italic text-2xl sm:text-[28px] text-dark mb-1">Nombre del Participante</p>
              <div class="mx-auto w-64 h-px bg-gradient-to-r from-transparent via-primary/60 to-transparent mb-4"></div>

              <p class="text-gray-600 text-xs sm:text-sm leading-relaxed max-w-lg mx-auto">
                por haber completado satisfactoriamente el curso teórico-práctico
                <strong class="text-dark">Rehabilitación Digital: de la planificación a la restauración definitiva</strong>,
                con una carga de <strong class="text-dark">1 día y medio</strong> en modalidad presencial (hands-on),
                dictado en Academia Dental, Temuco.
              </p>

              <!-- Firmas + sello -->
              <div class="grid grid-cols-3 items-end gap-4 mt-6">
                <div class="text-center">
                  <div class="mx-auto w-32 border-b border-dark/60 mb-1.5"></div>
                  <p class="text-xs font-semibold text-dark">Dr. Pedro Saavedra</p>
                  <p class="text-[11px] text-gray-400">Director Académico</p>
                </div>
                <div class="flex justify-center">
                  <div class="w-14 h-14 rounded-full border-2 border-secondary/60 bg-secondary/5 flex items-center justify-center rotate-[-8deg]">
                    <div class="text-center leading-tight">
                      <p class="text-[9px] tracking-widest text-secondary font-bold uppercase">Aprobado</p>
                      <p class="text-[8px] text-secondary/80 uppercase">Academia Dental</p>
                    </div>
                  </div>
                </div>
                <div class="text-center">
                  <div class="mx-auto w-32 border-b border-dark/60 mb-1.5"></div>
                  <p class="text-xs font-semibold text-dark">Dr. Mauricio Bizama</p>
                  <p class="text-[11px] text-gray-400">Docente del Programa</p>
                </div>
              </div>

              <div class="flex items-center justify-between mt-5 pt-3 border-t border-light text-[11px] text-gray-400">
                <span>Temuco, Chile — 15 de noviembre de 2026</span>
                <span class="font-mono tracking-wider">N° AD-2026-0001</span>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <section class="py-16 px-6 bg-light text-center">
    <h3 class="text-2xl font-extrabold text-dark mb-4">¿Tienes dudas sobre el proceso de certificación?</h3>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/contacto" class="bg-primary hover:bg-secondary text-white font-bold px-8 py-3.5 rounded-full transition-colors">Consultar</a>
      <a href="/cursos" class="border-2 border-primary text-primary hover:bg-primary hover:text-white font-bold px-8 py-3.5 rounded-full transition-colors">Ver Cursos</a>
    </div>
  </section>

</Layout>

<style >
.relative.py-20.px-6.overflow-hidden {
  background-position: center 71% !important;
}
</style>