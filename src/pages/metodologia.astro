---
const ICONS: Record<string,string> = {clipboard:`<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25Z"/></svg>`,wrench:`<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008Z"/></svg>`,box:`<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m21 7.5-9-5.25L3 7.5m18 0-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9"/></svg>`,phone:`<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3"/></svg>`};
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout title="Metodología — Academia Dental" description="Conoce el modelo pedagógico de Academia Dental: presencial hands-on, híbrido, práctica clínica y material entregado.">

  <PageHero
    title="Nuestra Metodología"
    breadcrumb={[{ label: 'Metodología' }]}
  />

  <!-- Modelo Presencial Hands-On -->
  <section class="py-20 px-6 bg-white">
    <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <div class="w-14 h-14 bg-blue-50 rounded-2xl flex items-center justify-center mb-6">
          <svg class="w-7 h-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
          </svg>
        </div>
        <h2 class="text-3xl font-extrabold text-dark mb-4">Modelo Presencial Hands-On</h2>
        <p class="text-gray-500 leading-relaxed mb-4">
          Nuestros cursos presenciales se desarrollan en instalaciones clínicas equipadas, donde cada participante trabaja directamente con el instrumental y los materiales del programa. No se aprende solo mirando; se aprende haciendo.
        </p>
        <ul class="space-y-3">
          {['Grupos reducidos (máximo 8-10 participantes)','Supervisión directa de especialistas','Atención de pacientes reales desde el primer módulo','Resolución de casos en tiempo real'].map(item => (
            <li class="flex items-center gap-3 text-sm text-dark">
              <svg class="w-4 h-4 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <div class="rounded-2xl overflow-hidden h-96">
        <img src={`${import.meta.env.BASE_URL}images/modelo-presencial.webp`} alt="Modelo Presencial Hands-On" class="w-full h-full object-cover" />
      </div>
    </div>
  </section>

  <!-- Modelo Híbrido -->
  <section class="py-20 px-6 bg-[#F5F7FA]">
    <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-12 items-center">
      <div class="order-2 lg:order-1 rounded-2xl overflow-hidden h-96">
        <img src={`${import.meta.env.BASE_URL}images/modelo-hibrido.webp`} alt="Modelo Híbrido" class="w-full h-full object-cover" />
      </div>
      <div class="order-1 lg:order-2">
        <div class="w-14 h-14 bg-blue-50 rounded-2xl flex items-center justify-center mb-6">
          <svg class="w-7 h-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
        </div>
        <h2 class="text-3xl font-extrabold text-dark mb-4">Modelo Híbrido</h2>
        <p class="text-gray-500 leading-relaxed mb-4">
          La modalidad híbrida combina sesiones teóricas en línea con jornadas prácticas presenciales. Ideal para profesionales que buscan flexibilidad sin sacrificar la calidad clínica.
        </p>
        <ul class="space-y-3">
          {['Módulos teóricos en plataforma online','Sesiones en vivo con el docente','Jornadas presenciales prácticas en sede','Acceso a grabaciones y material digital'].map(item => (
            <li class="flex items-center gap-3 text-sm text-dark">
              <svg class="w-4 h-4 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Práctica Clínica -->
  <section class="py-20 px-6 bg-white">
    <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <div class="w-14 h-14 bg-blue-50 rounded-2xl flex items-center justify-center mb-6">
          <svg class="w-7 h-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
          </svg>
        </div>
        <h2 class="text-3xl font-extrabold text-dark mb-4">Práctica Clínica</h2>
        <p class="text-gray-500 leading-relaxed mb-4">
          Todos nuestros programas incluyen jornadas de práctica clínica supervisada en Clínica Milenium. Trabajas con pacientes reales bajo la guía del especialista docente, consolidando técnicas en contextos auténticos.
        </p>
        <ul class="space-y-3">
          {['Clínica habilitada con equipamiento de primer nivel','Pacientes seleccionados según el nivel del programa','Feedback inmediato del docente','Registro fotográfico de casos'].map(item => (
            <li class="flex items-center gap-3 text-sm text-dark">
              <svg class="w-4 h-4 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <div class="rounded-2xl overflow-hidden h-96">
        <img src={`${import.meta.env.BASE_URL}images/practica-clinica.webp`} alt="Práctica Clínica" class="w-full h-full object-cover" />
      </div>
    </div>
  </section>

  <!-- Material Entregado -->
  <section class="py-20 px-6 text-white" style="background-color:#0E3A6B">
    <div class="max-w-7xl mx-auto text-center mb-12">
      <h2 class="text-3xl font-extrabold mb-4">Material Entregado</h2>
      <p class="text-blue-100 max-w-2xl mx-auto">Cada participante recibe un kit completo de materiales para desarrollar el programa y continuar aplicando lo aprendido.</p>
    </div>
    <div class="max-w-7xl mx-auto grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {[
        { icon: 'clipboard', title: 'Manual del curso', desc: 'Guías clínicas y protocolos actualizados.' },
        { icon: 'wrench', title: 'Instrumental', desc: 'Kit de instrumental específico del programa.' },
        { icon: 'box', title: 'Materiales clínicos', desc: 'Insumos para la práctica hands-on.' },
        { icon: 'phone', title: 'Acceso digital', desc: 'Plataforma con contenidos y grabaciones.' },
      ].map(item => (
        <div class="bg-white/10 border border-white/20 rounded-2xl p-6 text-center">
          <div class="w-12 h-12 mx-auto rounded-xl bg-white/15 text-white flex items-center justify-center mb-4"><Fragment set:html={ICONS[item.icon]} /></div>
          <h4 class="font-bold text-lg mb-2">{item.title}</h4>
          <p class="text-blue-200 text-sm">{item.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 px-6 bg-white text-center">
    <h3 class="text-2xl font-extrabold text-dark mb-4">¿Quieres conocer los programas disponibles?</h3>
    <div class="flex flex-wrap justify-center gap-4">
      <a href={`${import.meta.env.BASE_URL}cursos`} class="bg-primary hover:bg-secondary text-white font-bold px-8 py-3.5 rounded-full transition-colors">Ver Cursos</a>
      <a href={`${import.meta.env.BASE_URL}contacto`} class="border-2 border-primary text-primary hover:bg-primary hover:text-white font-bold px-8 py-3.5 rounded-full transition-colors">Contáctanos</a>
    </div>
  </section>

</Layout>
